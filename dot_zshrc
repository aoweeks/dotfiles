# ### Aliases ###

alias ls='eza --icons=auto --color=auto --group-directories-first'

_ls_depth() {
  local depth=$1
  shift # Remove the number from the argument list
  ls --tree --level="$depth" "$@"
}

for i in {2..4}; do
  alias "ls$i"="_ls_depth $i"
done

